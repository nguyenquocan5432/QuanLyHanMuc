# Chep file nay thanh .env (cung thu muc voi docker-compose.yml) roi dien mat khau.
# File .env da nam trong .gitignore nen khong bi dua len GitHub.

# Mat khau tai khoan sa cua SQL Server trong container.
# SQL Server yeu cau it nhat 8 ky tu, co chu hoa, chu thuong, so va ky tu dac biet.
SA_PASSWORD=

# Mat khau tai khoan admin trang quan tri Keycloak (http://localhost:8081)
KEYCLOAK_ADMIN_PASSWORD=

# Client secret dung chung giua Keycloak va ung dung web, dat mot chuoi bat ky
OIDC_CLIENT_SECRET=
